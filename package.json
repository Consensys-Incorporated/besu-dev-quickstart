{
  "name": "@consensys-software/besu-dev-quickstart",
  "version": "0.2.2",
  "description": "A utility that lets developers try out Besu for private or public networks",
  "main": "build/index.js",
  "type": "module",
  "repository": "git@github.com:Consensys/besu-dev-quickstart.git",
