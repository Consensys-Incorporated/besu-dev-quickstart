    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "husky": "^9.0.1",
    "lint-staged": "^17.0.0",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "cli-spinners": "^3.1.0",
    "express": "^5.0.0",
    "express-session": "^1.18.0",
    "got": "^16.0.0",
